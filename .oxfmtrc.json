{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".turbo",
    "pnpm-lock.yaml",
    "playwright-report",
    "test-results",
    "AGENTS.md"
  ]
}
