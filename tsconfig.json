{
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "tsBuildInfoFile": "./.cache/typecheck.tsbuildinfo"
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tests/**/*.ts",
    "*.ts",
    "scripts/**/*.ts",
    "docs/.vitepress/**/*.ts"
  ],
  "extends": "./tsconfig.base.json",
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/release/**",
    ".artifacts/**",
    "apps/desktop/.package/**"
  ]
}
