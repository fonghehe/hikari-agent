# Evaluation commands load .env automatically; CLI commands use exported AGENT_* variables.
# Desktop model profiles are separate. Never commit actual credentials.
AGENT_MODEL=
AGENT_API_KEY=
AGENT_BASE_URL=
AGENT_PROVIDER=compatible
# Leave AGENT_BASE_URL blank to use a provider preset, or set the service's actual URL.
# Optional evaluation settings (omit case selectors to run all cases).
# EVAL_CASES=cart-rounding,test-driven-repair
# EVAL_SAMPLES=1
# EVAL_REPOSITORY_SUITE=/absolute/path/to/local-suite.json
# CAPABILITY_CASES=plan-is-read-only,cancel-live-model-stream
# AGENT_MAX_TOKENS=100000
# AGENT_CONTEXT_WINDOW=64000
# AGENT_MAX_OUTPUT_TOKENS=4096
# AGENT_STREAMING=true
# Optional server PostgreSQL/Redis; omit to use local SQLite.
# DATABASE_URL=postgres://forge:local-development-only@127.0.0.1:5432/forge
# REDIS_URL=redis://127.0.0.1:6379
PORT=4318
HOST=127.0.0.1
# Optional persistent goal (shares the run's existing resource limits).
# AGENT_GOAL=Resolve the failing tests and pass acceptance
# AGENT_GOAL_CONTINUATIONS=5

# Local remote control: loopback by default. Use HTTPS or SSH for other devices.
# HIKARI_REMOTE_HOST=127.0.0.1
# HIKARI_REMOTE_TOKEN=provide-a-private-token-with-at-least-32-characters

# Self-hosted execution worker; credentials remain on the execution machine.
# HIKARI_SERVER_URL=https://hikari.example.com
# HIKARI_WORKER_PROJECTS={"my-project":"/srv/projects/my-project"}
# HIKARI_ACCOUNT_TOKEN=
# HIKARI_WORKER_TOKEN=
# HIKARI_ALLOWED_COMMANDS=[]
# HIKARI_WORKER_ALLOW_NETWORK=false
# HIKARI_WORKER_MAX_TOKENS=100000
# HIKARI_WORKER_EXECUTION=restricted

# API-side GitHub webhook routing; see docs/platform.md for the route schema.
# HIKARI_GITHUB_WEBHOOK_SECRET=
# HIKARI_GITHUB_ROUTES=[]
# GITHUB_TOKEN=

# Self-hosted execution limits (per account). Credentials remain on workers.
HIKARI_MAX_ACTIVE_JOBS=10
HIKARI_MAX_WORKERS=5
HIKARI_JOB_MAX_TOKENS=200000
HIKARI_JOB_MAX_MS=1800000
# Optional operations-only bearer token, at least 32 random characters.
# HIKARI_OPS_TOKEN=
# Real-model report gates; baseline validation reports are rejected.
# EVAL_MIN_CASES=5
# EVAL_MIN_SAMPLES=3
# EVAL_MIN_SUCCESS_RATE=0.9
# EVAL_MAX_P95_MS=180000
