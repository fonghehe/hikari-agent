{
  "name": "hikari-agent-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @hikari/desktop dev",
    "build": "turbo run build",
    "typecheck": "node scripts/typecheck.mjs",
    "lint": "oxlint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test:e2e": "pnpm --filter @hikari/desktop build && pnpm docs:build && playwright test",
    "agent": "tsx apps/cli/src/index.ts",
    "server": "pnpm --filter @hikari/server dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "postinstall": "node scripts/prepare-native.mjs && node apps/desktop/scripts/ocr-assets.mjs",
    "test:services": "tsx scripts/verify-services.ts",
    "test:cli": "node scripts/smoke-cli.mjs",
    "desktop:pack": "pnpm --filter @hikari/desktop run pack",
    "desktop:dist": "pnpm --filter @hikari/desktop run dist",
    "test:package": "node scripts/smoke-desktop-package.mjs",
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "eval:retrieval": "node --import tsx scripts/evals/retrieval.ts",
    "eval:agent": "node --import tsx scripts/evals/run.ts",
    "eval:repository": "node --import tsx scripts/evals/repository.ts",
    "eval:capabilities": "node --import tsx scripts/evals/capabilities.ts",
    "vscode:pack": "node scripts/package-vscode.mjs",
    "eval:report": "node --import tsx scripts/evals/report.ts",
    "catalog": "pnpm dlx codemod pnpm/catalog",
    "clean:build": "node scripts/clean.mjs build",
    "clean:reports": "node scripts/clean.mjs reports",
    "clean:cache": "node scripts/clean.mjs cache"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "@napi-rs/canvas": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@xterm/headless": "catalog:",
    "esbuild": "catalog:",
    "node-pty": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "sharp": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitepress": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
